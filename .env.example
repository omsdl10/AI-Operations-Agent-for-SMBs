# App
APP_NAME="AI Operations Agent"
APP_ENV=development
APP_DEBUG=true
API_V1_PREFIX=/api/v1

# Frontend
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
LOG_LEVEL=INFO

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ai_operations
POSTGRES_USER=ai_operations
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://ai_operations:change-me@postgres:5432/ai_operations

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET_KEY=change-this-development-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Future integrations
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_AUTO_REPLY_ENABLED=true
AI_LOW_CONFIDENCE_THRESHOLD=0.65
AUTOMATION_SCHEDULER_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=15
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_MOCK_MODE=true
TWILIO_DEFAULT_BUSINESS_ID=
